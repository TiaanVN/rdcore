RADIUSDESK_VOLUME=/mnt/data/radiusdesk
RADIUSDESK_NETWORK=radiusdesk-bridge

# --- HTTPS / Caddy Reverse Proxy ---
# By default, Caddy is DISABLED. RADIUSdesk serves plain HTTP directly on port 80.
#
# To ENABLE Caddy HTTPS:
#   1. Set COMPOSE_PROFILES=caddy
#   2. Change RADIUSDESK_HTTP_PORT=8080 (frees host port 80 for Caddy)
#   3. (Optional) Set DOMAIN=radius.example.com for Let's Encrypt certificates
#
COMPOSE_PROFILES=
RADIUSDESK_HTTP_PORT=8080
DOMAIN=localhost
